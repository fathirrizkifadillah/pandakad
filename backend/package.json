{
	"name": "pandakad-backend",
	"version": "1.0.0",
	"description": "Backend REST API Sistem Akademik Universitas Panda Raya (UNPANDA)",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"lint": "npx @biomejs/biome check src tests",
		"format": "npx @biomejs/biome format --write src tests",
		"test": "vitest run",
		"test:watch": "vitest",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:seed": "prisma db seed",
		"prisma:studio": "prisma studio",
		"db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"argon2": "^0.41.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"express-rate-limit": "^7.5.0",
		"helmet": "^8.0.0",
		"pino": "^9.6.0",
		"pino-http": "^10.4.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/cookie-parser": "^1.4.8",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.13.4",
		"@types/supertest": "^6.0.2",
		"pino-pretty": "^13.0.0",
		"prisma": "^6.19.3",
		"supertest": "^7.0.0",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"vitest": "^3.0.5"
	}
}
